<%
	const pageUrl = typeof canonical !== 'undefined' && canonical ? canonical : `https://${url}`
	const socialImage = typeof preview_thumbnail !== 'undefined' && preview_thumbnail ? preview_thumbnail : 'https://adblock.turtlecute.org/assets/preview_toolz.jpg'
%>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#161625">
	<% if (typeof noindex !== 'undefined' && noindex) { %>
	<meta name="robots" content="noindex, nofollow">
	<meta name="googlebot" content="noindex, nofollow">
	<% } else { %>
	<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
	<meta name="googlebot" content="index, follow">
	<% } %>

	<!-- Resource Hints -->
	<link rel="preconnect" href="https://umami.priorato.org" crossorigin>

	<!-- Analytics -->
    <script async src="https://umami.priorato.org/priorato.js" data-website-id="4eaed2d0-1d01-44b6-9381-d1f4a80a99fc"></script>
	<link rel="icon" href="./assets/<%=page%>/icon.svg" type="image/svg+xml">
	<% if (typeof canonical !== 'undefined' && canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
    <title><%= title %></title>
  	<meta name="author" content="Turtlecute">
	<meta name="description" content="<%= description %>">

	<% if (typeof noindex === 'undefined' || !noindex) { %>
	<!-- Google / Search Engine Tags -->
	<meta itemprop="name" content="<%= title %>">
	<meta itemprop="description" content="<%= description %>">
	<meta itemprop="image" content="<%= socialImage %>">

	<!-- Open Graph Tags -->
	<meta property="og:url" content="<%= pageUrl %>">
	<meta property="og:type" content="website">
	<meta property="og:title" content="<%= title %>">
	<meta property="og:description" content="<%= description %>">
	<meta property="og:image" content="<%= socialImage %>">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:image:alt" content="<%= title %> - Preview">
	<meta property="og:site_name" content="AdBlockTest">
	<meta property="og:locale" content="en_US">

	<!-- Twitter Meta Tags -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:url" content="<%= pageUrl %>">
	<meta name="twitter:title" content="<%= title %>">
	<meta name="twitter:description" content="<%= description %>">
	<meta name="twitter:image" content="<%= socialImage %>">
	<meta name="twitter:image:alt" content="<%= title %> - Preview">

	<!-- Structured Data (JSON-LD) -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		"@id": "<%= pageUrl %>#app",
		"name": "<%= title %>",
		"alternateName": "AdBlockTest",
		"description": "<%= description %>",
		"url": "<%= pageUrl %>",
		"applicationCategory": "UtilityApplication",
		"applicationSubCategory": "Ad blocker, tracker blocker, and DNS filter testing",
		"operatingSystem": "Any",
		"isAccessibleForFree": true,
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD"
		},
		"author": {
			"@type": "Person",
			"name": "Turtlecute",
			"url": "https://github.com/Turtlecute33"
		},
		"maintainer": {
			"@type": "Person",
			"name": "Turtlecute",
			"url": "https://github.com/Turtlecute33"
		},
		"publisher": {
			"@type": "Person",
			"name": "Turtlecute",
			"url": "https://turtlecute.org"
		},
		"image": "<%= socialImage %>",
		"screenshot": "<%= socialImage %>",
		"featureList": [
			"Cosmetic filter testing",
			"Ad script blocking checks",
			"Host and DNS filter coverage checks",
			"Detailed browser and blocker compatibility results"
		],
		"keywords": "ad blocker test, adblock test, tracker blocker test, DNS filter test, uBlock Origin test",
		"inLanguage": "en",
		"browserRequirements": "Requires JavaScript. Requires HTML5.",
		"softwareVersion": "<%= require('./package.json').version %>"
	}
	</script>

	<% if (typeof faqSchema !== 'undefined' && faqSchema) { %>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": [
			{
				"@type": "Question",
				"name": "How does the ad blocker test work?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "One click runs three independent checks and scores how much of your setup blocks ads and trackers. No real ads or trackers are ever loaded during the test."
				}
			},
			{
				"@type": "Question",
				"name": "My ad blocker is configured correctly but the test does not work. Why?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Your configuration may not be compatible with the type of checks this tool performs. This does not mean your ad blocker is not providing protection. JavaScript limitations or missing features may prevent the test from accurately determining blocked connections. You will still receive an estimate of the percentage of connections blocked."
				}
			},
			{
				"@type": "Question",
				"name": "How can I get 100% on the ad blocker test?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "A green score indicates satisfactory protection and there is no need to aim for 100%. However, if you want a perfect score, you can use the Turtlecute Host List which covers most of the host tests on the site (excluding cosmetic filters and script loading)."
				}
			},
			{
				"@type": "Question",
				"name": "What do the three test categories check?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Cosmetic Filter: whether empty ad boxes, cookie banners and similar elements are hidden or removed. Script Loading: whether ad scripts and trackers are stopped from loading. Host: whether domains that serve trackers, analytics or ads are blocked."
				}
			},
			{
				"@type": "Question",
				"name": "What do Blocked and Not Blocked mean?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Blocked means the connection to a host or script failed, or an ad box was removed, so your ad blocker caught it. Not Blocked means the connection went through, or the box stayed in place, so that item was not filtered by your setup."
				}
			},
			{
				"@type": "Question",
				"name": "How is my score calculated, and what do the colors mean?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Points come from how many checks your setup blocks in each category. Red means your ad blocker may not be enabled or configured, orange means okay but you can do better, and green means great, you are ready to surf."
				}
			},
			{
				"@type": "Question",
				"name": "Which ad blockers and DNS filters do you recommend?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "DNSFilter as the main DNS resolver with NextDNS as a great alternative, plus uBlock Origin in Brave or Kiwi Browser on desktop and Android, and Brave or Safari with the AdGuard extension on iOS. Recommended filter lists: HaGeZi Ultimate blocklists, uBlock filters, and AdGuard filters."
				}
			},
			{
				"@type": "Question",
				"name": "What other ad blocker test tools do you recommend?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "CanYouBlockIt, IP Leak, Block Ads Test, Browser Fingerprint by EFF, and the ad blocker and popup tests by raymondhill."
				}
			}
		]
	}
	</script>
	<% } %>
	<% } %>

</head>
